{
  "AllowDocumentation": true,
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseProvider": "PostgreSQL",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=crm_db;Username=postgres;Password=${DB_PASSWORD:-postgres}"
  },
  "Authentication": {
    "JwtIssuerOptions": {
      "Issuer": "crmApi",
      "Audience": "http://localhost:5000/",
      "SecretKey": "YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_32_BYTES_LONG!"
    }
  },
  "ReCaptcha": {
    "Enabled": false,
    "PrivateKey": "",
    "PublicKey": ""
  },
  "Storage": {
    "Type": "FileSystem",
    "Folder": "wwwroot/uploads"
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1",
    "BucketName": "your-bucket-name"
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "your-container-name"
  },
  "EmailSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "noreply@crm.local"
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "ConnectionPool": {
    "MinPoolSize": 10,
    "MaxPoolSize": 100,
    "ConnectionTimeout": 30,
    "ConnectionLifetime": 60
  }
}